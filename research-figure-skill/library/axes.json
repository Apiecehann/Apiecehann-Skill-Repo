          ],
          "avoid": [
            "期刊投稿"
          ],
          "status": "implemented"
        }
      ]
    },
    "color_structure": {
      "question": "先看 series 数：2 个还是 N 个；再决定 accent、paired 还是 categorical。",
      "options": [
        {
          "id": "focus-neutral",
          "label": "1 accent + neutral",
          "when": [
            "一个焦点",
