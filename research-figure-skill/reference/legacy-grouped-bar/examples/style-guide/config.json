{
  "data": "data.csv",
  "preset": {
    "style": "paper-clean",
    "layout": "grouped",
    "palette": "tol-bright"
  },
  "series_order": [
    "dp3",
    "code-diffuser",
    "pi0",
    "saga-language",
    "saga-point"
  ],
