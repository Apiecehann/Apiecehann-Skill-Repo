      0,
      0.25,
      0.5,
      0.75,
      1
    ],
    "tick_format": ".0%",
    "ylabel": "Success rate"
  },
  "legend_defaults": {
    "labels": {
      "dp3": "DP3",
      "code-diffuser": "CodeDiffuser",
      "pi0": "π0",
      "saga-language": "SAGA-Language",
      "saga-point": "SAGA-Point"
    }
  }
}
