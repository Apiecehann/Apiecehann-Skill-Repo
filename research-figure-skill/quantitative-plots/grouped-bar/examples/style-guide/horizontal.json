{
  "data": "../affordance-distribution/data.csv",
  "preset": {
    "style": "soft-outline",
    "layout": "horizontal",
    "palette": "tol-muted",
    "font": "mono"
  },
  "series_order": [
    "grasp",
    "place",
    "walk_to",
    "direct_c.",
    "indirect_c.",
    "function",
    "avoid",
    "step_on"
  ],
  "panel_defaults": {
    "limits": [
      0,
      1
    ],
    "ticks": [
      0,
      0.5,
      1
    ],
    "tick_format": ".0%",
    "value_format": ".1%",
    "value_font": "bold",
    "ylabel": "Percentage of data"
  }
}
