{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Figure IR",
  "type": "object",
  "properties": {
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "chart": {
      "type": "string",
      "enum": [
        "grouped-bar",
        "distribution-overlap",
        "dot-plot",
        "dumbbell",
        "line-band",
        "scatter",
        "box",
        "violin",
        "ecdf",
        "kde",
        "heatmap",
        "roc",
        "pr",
        "calibration",
        "surface",
        "scatter3d",
        "voxel",
        "ridgeline",
        "det",
        "node-link",
        "sankey",
        "treemap",
        "radar",
        "bar3d",
        "mesh3d",
        "quiver3d",
        "sunburst",
        "icicle",
        "chord"
      ]
    },
    "data": {
      "type": "string",
      "minLength": 1
    },
    "title_prefix": {
      "type": "string"
    },
    "reference": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "axis": {
            "type": "string",
            "enum": ["x", "y"]
          },
          "value": {
            "type": "number"
          },
          "label": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "linestyle": {
            "type": "string"
          }
        },
        "required": ["value"],
        "additionalProperties": false
      }
    },
    "stats": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["ci-band", "trend", "confidence-ellipse"]
          },
          "level": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 0.999
          },
          "method": {
            "type": "string",
            "enum": ["linear"]
          }
        },
        "required": ["kind"],
        "additionalProperties": false
      }
    },
    "overlays": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["raw-points", "significance-bracket"]
          },
          "jitter": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.5
          },
          "alpha": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 2,
            "maxItems": 2
          },
          "label": {
            "type": "string"
          },
          "y": {
            "type": "number"
          }
        },
        "required": ["kind"],
        "additionalProperties": false
      }
    },
    "encoding": {
      "type": "object",
      "properties": {
        "x": {
          "type": "string",
          "minLength": 1
        },
        "y": {
          "type": "string",
          "minLength": 1
        },
        "series": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "weight": {
          "type": "string",
          "minLength": 1
        },
        "replicate": {
          "type": "string",
          "minLength": 1
        },
        "axis": {
          "type": "string",
          "minLength": 1
        },
        "u": {
          "type": "string",
          "minLength": 1
        },
        "v": {
          "type": "string",
          "minLength": 1
        },
        "w": {
          "type": "string",
          "minLength": 1
        },
        "parent": {
          "type": "string",
          "minLength": 1
        },
        "row": {
          "type": "string",
          "minLength": 1
        },
        "col": {
          "type": "string",
          "minLength": 1
        },
        "score": {
          "type": "string",
          "minLength": 1
        },
        "z": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "panel": {
          "type": "string",
          "minLength": 1
        },
        "capacity": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "low": {
          "type": "string",
          "minLength": 1
        },
        "high": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "base": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "size": {
      "type": "object",
      "properties": {
        "preset": {
          "type": "string",
          "enum": [
            "single",
            "medium",
            "double",
            "slide"
          ]
        }
      },
      "required": [
        "preset"
      ],
      "additionalProperties": false
    },
    "theme": {
      "type": "object",
      "properties": {
        "style": {
          "type": "string",
          "minLength": 1
        },
        "palette": {
          "type": "string",
          "minLength": 1
        },
        "font": {
          "type": "string",
          "minLength": 1
        },
        "colormap": {
          "type": "string",
          "minLength": 1
        },
        "type_scale": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 3
        },
        "hatch": {
          "type": "boolean"
        },
        "series_styles": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "fill_alpha": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "edge_alpha": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "label_alpha": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "hatch": {
                "type": "string"
              }
            },
            "required": [],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "style",
        "palette",
        "font"
      ],
      "additionalProperties": false
    },
    "labels": {
      "type": "object",
      "properties": {
        "values": {
          "type": "boolean"
        },
        "legend": {
          "type": "string",
          "enum": [
            "top",
            "none"
          ]
        },
        "value_format": {
          "type": "string",
          "minLength": 1
        },
        "value_size": {
          "type": "number",
          "minimum": 4,
          "maximum": 20
        }
      },
      "required": [
        "values",
        "legend"
      ],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "formats": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "png",
              "pdf",
              "svg"
            ]
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "dpi": {
          "type": "integer",
          "minimum": 36,
          "maximum": 1200
        },
        "svg_text": {
          "type": "boolean"
        }
      },
      "required": [
        "formats",
        "dpi",
        "svg_text"
      ],
      "additionalProperties": false
    },
    "layout": {
      "type": "string",
      "enum": [
        "grouped",
        "horizontal",
        "paired"
      ]
    },
    "series_order": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "series_labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "series_roles": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "emphasis": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "card": {
            "type": "string",
            "minLength": 1
          },
          "series": {
            "type": "string",
            "minLength": 1
          },
          "accent": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "card",
          "series"
        ],
        "additionalProperties": false
      }
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "card": {
            "type": "string",
            "minLength": 1
          },
          "group": {
            "type": "string",
            "minLength": 1
          },
          "panel": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "label_format": {
            "type": "string",
            "minLength": 1
          },
          "label_scale": {
            "type": "number"
          },
          "label_suffix": {
            "type": "string"
          }
        },
        "required": [
          "card",
          "from",
          "to"
        ],
        "additionalProperties": false
      }
    },
    "axis": {
      "type": "object",
      "properties": {
        "x_label": {
          "type": "string"
        },
        "z_label": {
          "type": "string"
        },
        "y_label": {
          "type": "string"
        },
        "x_min": {
          "type": "number"
        },
        "x_max": {
          "type": "number"
        },
        "bins": {
          "type": "integer",
          "minimum": 5,
          "maximum": 100
        },
        "y_format": {
          "type": "string",
          "minLength": 1
        },
        "y_max": {
          "type": [
            "number",
            "null"
          ]
        },
        "baseline": {
          "type": "number"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "view": {
      "type": "object",
      "properties": {
        "elev": {
          "type": "number"
        },
        "azim": {
          "type": "number"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "threshold": {
      "type": "number"
    },
    "fill": {
      "type": "boolean"
    },
    "grid": {
      "type": "boolean"
    }
  },
  "required": [
    "claim",
    "chart",
    "data",
    "encoding",
    "size",
    "theme",
    "labels",
    "output"
  ],
  "additionalProperties": false
}
