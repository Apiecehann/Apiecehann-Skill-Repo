{
  "claim": "在演示中突出一个方法在三个模拟基准上的结果。",
  "chart": "grouped-bar",
  "data": "data.csv",
  "encoding": {
    "x": "group",
    "y": "value",
    "series": "series"
  },
  "size": {
    "preset": "double"
  },
  "theme": {
    "style": "soft-outline",
    "palette": "neutral-accent",
    "font": "sans",
    "type_scale": 1.5
  },
  "labels": {
    "values": false,
    "legend": "top"
  },
  "output": {
    "formats": [
      "png",
      "pdf",
      "svg"
    ],
    "dpi": 300,
    "svg_text": true
  },
  "series_order": [
    "method-1",
    "method-2",
    "method-3",
    "ours"
  ],
  "axis": {
    "y_label": "Score",
    "y_format": ".0%"
  },
  "emphasis": [
    {
      "card": "focus-gray",
      "series": "ours"
    }
  ],
  "series_labels": {
    "method-1": "Method 1",
    "method-2": "Method 2",
    "method-3": "Method 3",
    "ours": "Ours"
  }
}
